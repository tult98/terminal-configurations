# Local secrets and machine-specific config — DO NOT commit this file!
# Copy to ~/.zshenv.local and fill in your actual values.
# Sourced from ~/.zshenv (all zsh shells, including non-interactive).
#
# Work (Employment Hero) variables live in the private eh-dotfiles repo, which appends
# its own placeholders here when you run its install.sh.

# Add personal tokens below, e.g.:
# export GITHUB_TOKEN=<your-token>

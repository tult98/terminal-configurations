theme "tokyo-night"
default_layout "compact"

options {
    // Off so Ghostty owns the mouse: native smooth pixel scroll + text
    // selection, instead of Zellij stepping through scrollback line-by-line.
    // Keyboard scrollback still available via Scroll mode (Ctrl+s).
    mouse_mode false

    // URL clicking is Ghostty's job (mouse_mode off = Ghostty owns the mouse):
    // hold ⌘ and the URL underlines, ⌘+click opens it in the browser.
    // Keep OSC8 passthrough ON so program-emitted hyperlinks (gh, eza/ls
    // --hyperlink, build tools) also reach Ghostty as ⌘-clickable links.
    // Pinned explicitly so a future zellij default change can't silently break it.
    osc8_hyperlinks true

    scroll_buffer_size 10000
    copy_command "pbcopy"
    on_force_close "detach"
    default_shell "zsh"
}

keybinds {
    // Free Ctrl+o so it passes through to the running app (Claude Code uses it).
    // Zellij binds it to "Session" mode by default; unbind everywhere and move
    // that mode onto Ctrl+b instead.
    unbind "Ctrl o"
    normal {
        bind "Ctrl b" { SwitchToMode "Session"; }
    }

    // Ctrl+y → open Yazi in a floating pane that closes when you quit Yazi (q).
    // Bound at the Zellij level (not zsh) so it fires inside any app — Claude
    // Code, vim, etc. — not just at the shell prompt. The pane inherits the
    // focused pane's cwd, so Yazi opens in the current folder.
    // Available in every mode except "locked" so it never shadows text input.
    shared_except "locked" {
        // Free Alt+f / Alt+Arrow so they pass through to the running app.
        // Ghostty maps Opt+Right → ESC-f (Alt+f); Zellij's default binds Alt+f to
        // ToggleFloatingPanes, which is the "Opt+Right opens a popup pane" bug.
        // Must be unbound HERE, inside shared_except — a top-level unbind does not
        // override defaults defined in a shared_* scope. Alt+Arrow defaults to
        // MoveFocusOrTab; unbind it too so a stray Alt+Arrow can't jump panes
        // (focus movement is on Cmd+Arrow → Alt h/j/k/l, which stays bound).
        unbind "Alt f"
        unbind "Alt Left" "Alt Right" "Alt Up" "Alt Down"

        bind "Ctrl y" {
            Run "yazi" {
                floating true
                close_on_exit true
                name "yazi"
                width "90%"
                height "90%"
                x "5%"
                y "5%"
            }
        }

        // macOS-style pane shortcuts, fed by Ghostty's cmd+* keybinds which
        // emit these Alt+<letter> sequences (Cmd never reaches the TTY).
        bind "Alt d" { NewPane "Right"; }       // ⌘D       → vertical split
        bind "Alt e" { NewPane "Down"; }        // ⇧⌘D      → horizontal split
        bind "Alt z" { ToggleFocusFullscreen; } // ⇧⌘Enter  → zoom / unzoom

        // ⌘1–⌘9 → jump straight to tab N (fed by Ghostty's cmd+<n> keybinds).
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
    }
}
